# tusShare Configuration
# Copy this to .env and update values before running.

# --- REQUIRED: Change these ---

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
TUSSHARE_JWT_SECRET=CHANGE-ME-generate-a-random-64-char-hex-string

# Admin bootstrap (used on first run only if users table is empty)
TUSSHARE_ADMIN_USERNAME=admin
TUSSHARE_ADMIN_PASSWORD=CHANGEME

# PostgreSQL passwords — two separate accounts with different privilege levels.
# The postgres superuser is used only for first-run bootstrap; the app never
# connects as it after that. The tusshare user is a limited account that can
# manage data in the tusshare database but cannot create roles or databases.
TUSSHARE_PG_SUPERUSER_PASSWORD=CHANGEME
TUSSHARE_PG_PASSWORD=CHANGEME

# PostgreSQL connection string for the app — uses the limited tusshare user.
TUSSHARE_DATABASE_URL=postgresql://tusshare:CHANGEME@postgres:5432/tusshare

# First-run bootstrap: required on initial startup to create the sensitive_config
# schema. Must use the postgres superuser (the app user lacks CREATEROLE).
# Remove after the first successful startup — ignored once the schema exists.
TUSSHARE_SUPERUSER_URL=postgresql://postgres:CHANGEME@postgres:5432/tusshare

# --- Security ---

# Redirect HTTP → HTTPS based on X-Forwarded-Proto header from the reverse proxy.
# Enable only when the app port is NOT directly internet-accessible (i.e. traffic
# always routes through nginx or Cloudflare first, preventing header spoofing).
# TUSSHARE_FORCE_HTTPS=false

# Step-up authentication — sudo window for sensitive actions (password change,
# user deletion, security settings, etc.). 0 = single-use tokens (strictest).
# TUSSHARE_STEP_UP_WINDOW_SECONDS=300
# TUSSHARE_STEP_UP_MAX_FAILURES=3

# --- Optional: Adjust as needed ---

# Debug mode (enables /api/docs Swagger UI — disable in production)
# TUSSHARE_DEBUG=false

# Data directory (inside container — change only if not using Docker volumes)
# TUSSHARE_DATA_DIR=/data
# TUSSHARE_FILES_DIR=/data/files
# TUSSHARE_UPLOADS_DIR=/data/uploads

# JWT token lifetimes
# TUSSHARE_ACCESS_TOKEN_EXPIRE_MINUTES=5
# TUSSHARE_REFRESH_TOKEN_EXPIRE_DAYS=7
# TUSSHARE_SESSION_IDLE_TIMEOUT_MINUTES=10

# Upload settings
# TUSSHARE_DEFAULT_CHUNK_SIZE=5242880
# TUSSHARE_TUS_UPLOAD_EXPIRY_HOURS=24

# Admin panel defaults — seed the database on first run; overridable via admin UI after that.
# TUSSHARE_OPEN_REGISTRATION=false
# TUSSHARE_GLOBAL_MAX_FILE_SIZE=0       # bytes; 0 = no limit
# TUSSHARE_GLOBAL_BANDWIDTH_LIMIT=0     # bytes/s; 0 = no limit
# TUSSHARE_DISK_WARNING_THRESHOLD=65    # filesystem usage % that triggers admin alert

# Rate limiting
# TUSSHARE_RATE_LIMIT_LOGIN=5           # requests per 15 min per IP (login/register/password)
# TUSSHARE_RATE_LIMIT_API=60            # requests per min per user
# TUSSHARE_RATE_LIMIT_SHARE_CREATE=5    # share creations per min per user
# TUSSHARE_RATE_LIMIT_UPLOAD=10         # upload initiations per min per user
# TUSSHARE_RATE_LIMIT_MANAGEMENT=120    # folder/share CRUD actions per min per user

# Error-rate escalation (brute-force / scanning detection)
# IPs that accumulate >= ERROR_THRESHOLD non-429 4xx/5xx responses within
# ERROR_WINDOW seconds are throttled to ESCALATED_MAX req/ESCALATED_WINDOW sec
# for ESCALATED_DURATION seconds. Set ERROR_THRESHOLD=0 to disable entirely.
# TUSSHARE_RATE_LIMIT_ERROR_THRESHOLD=5
# TUSSHARE_RATE_LIMIT_ERROR_WINDOW=60
# TUSSHARE_RATE_LIMIT_ESCALATED_MAX=1
# TUSSHARE_RATE_LIMIT_ESCALATED_WINDOW=1
# TUSSHARE_RATE_LIMIT_ESCALATED_DURATION=300

# Share session tokens (public share access, IP/UA-bound)
# TUSSHARE_SHARE_SESSION_EXPIRE_HOURS=2

# Trusted proxy header (set by nginx / Cloudflare)
# TUSSHARE_TRUSTED_IP_HEADER=X-Real-IP
