# tusShare Configuration
# Copy this to .env and update values before running.

# =============================================================================
# REQUIRED — change all of these before first startup
# =============================================================================

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TUSSHARE_JWT_SECRET=CHANGE-ME-generate-a-random-64-char-hex-string

# PostgreSQL passwords.
# TUSSHARE_PG_SUPERUSER_PASSWORD: the postgres superuser — used only during
#   first-run bootstrap to create the app user and run schema migrations.
#   The app never connects as this account after startup.
# TUSSHARE_PG_PASSWORD: the limited tusshare app user — all runtime queries
#   use this account; it has no CREATEROLE or cross-database access.
TUSSHARE_PG_SUPERUSER_PASSWORD=CHANGEME
TUSSHARE_PG_PASSWORD=CHANGEME

# PostgreSQL connection string for the app (limited tusshare user).
TUSSHARE_DATABASE_URL=postgresql://tusshare:CHANGEME@postgres:5432/tusshare

# First-run bootstrap: required on initial startup to create the
# sensitive_config schema.  Must use the postgres superuser (the app user
# lacks CREATEROLE).  Safe to remove after the first successful startup.
TUSSHARE_SUPERUSER_URL=postgresql://postgres:CHANGEME@postgres:5432/tusshare

# WebAuthn relying-party domain.
# Must match the exact hostname users visit in their browser.
# Passkey registration and authentication will silently fail in Firefox and
# Chrome if this does not match — set it before enrolling any passkeys.
#   Production:  TUSSHARE_WEBAUTHN_RP_ID=files.example.com
#   Development: TUSSHARE_WEBAUTHN_RP_ID=localhost
TUSSHARE_WEBAUTHN_RP_ID=CHANGE-ME-your-actual-domain


# =============================================================================
# SECURITY & ENCRYPTION KEYS
# =============================================================================

# HTTPS enforcement — redirect HTTP → HTTPS via X-Forwarded-Proto.
# Enable only when the app port is not directly internet-accessible; traffic
# must always route through nginx, Cloudflare, or another TLS-terminating
# proxy so that X-Forwarded-Proto cannot be spoofed by external clients.
# TUSSHARE_FORCE_HTTPS=false

# Step-up authentication — sudo window for sensitive actions (admin config,
# user deletion, security settings, etc.).
# 0 = single-use tokens, strictest.  >0 = window in seconds.
# TUSSHARE_STEP_UP_WINDOW_SECONDS=300
# TUSSHARE_STEP_UP_MAX_FAILURES=3

# Encryption keys for credential blobs stored in the database.
# Each key is a 32-byte base64url string.  If left empty, the key is derived
# from JWT_SECRET via HKDF — existing deployments work without setting these.
# Provide explicit keys to allow independent rotation without rotating
# JWT_SECRET (which would invalidate all active sessions).
#
# MFA_ENCRYPTION_KEY:     encrypts TOTP secrets and WebAuthn credential blobs
# IDP_ENCRYPTION_KEY:     encrypts LDAP bind passwords and OIDC client secrets
# STORAGE_ENCRYPTION_KEY: encrypts storage volume credentials (S3 keys, etc.)
# NOTIF_ENCRYPTION_KEY:   encrypts notification channel signing secrets
#
# Generate with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# TUSSHARE_MFA_ENCRYPTION_KEY=
# TUSSHARE_IDP_ENCRYPTION_KEY=
# TUSSHARE_STORAGE_ENCRYPTION_KEY=
# TUSSHARE_NOTIF_ENCRYPTION_KEY=

# Trusted proxy IP header (set by nginx / Cloudflare).
# TUSSHARE_TRUSTED_IP_HEADER=X-Real-IP

# Cloudflare proxy — trust CF-Connecting-IP for rate-limit keys.
# Enable ONLY when origin is locked down to accept connections exclusively
# from known Cloudflare IP ranges (firewall/network-level enforcement).
# Without this enforcement, any client can spoof its IP and bypass rate limits.
# TUSSHARE_CLOUDFLARE_PROXY_ENABLED=false


# =============================================================================
# MULTI-WORKER / REDIS
# =============================================================================

# Redis connection URL.  Required when running multiple app containers or
# workers (e.g. gunicorn -w 4, Docker Swarm, Kubernetes).
# When set, rate-limit counters, SSE events, upload-eviction offsets, and
# S3/Azure multipart upload state are shared across all workers via Redis.
# Without Redis, each worker has its own in-process state — uploads that
# land on different workers across chunks will fail.
# TUSSHARE_REDIS_URL=redis://redis:6379/0


# =============================================================================
# WEBAUTHN / MFA
# =============================================================================

# Human-readable relying-party name shown in authenticator dialogs.
# TUSSHARE_WEBAUTHN_RP_NAME=tusShare

# Window (seconds) between completing OPAQUE login and submitting the MFA
# challenge.  Increase if users complain of "challenge expired" errors on
# slow connections.
# TUSSHARE_MFA_PENDING_TOKEN_TTL=90

# Public/shared device session refresh token TTL.
# Applied when the user checks "Public device" at login — intentionally much
# shorter than the normal REFRESH_TOKEN_EXPIRE_DAYS to limit exposure if the
# user forgets to log out.
# TUSSHARE_PUBLIC_DEVICE_REFRESH_TOKEN_MINUTES=60


# =============================================================================
# IDENTITY PROVIDERS (LDAP / OIDC)
# =============================================================================

# Allow HTTP (non-TLS) OIDC issuer URLs.
# Enable only when your OIDC provider runs on a trusted internal network
# without TLS.  Default (false) enforces HTTPS to protect JWKS fetches
# and discovery endpoints from MITM attacks.
# TUSSHARE_ALLOW_HTTP_IDP=false


# =============================================================================
# ANTIVIRUS / SERVER-SIDE SCANNING
# =============================================================================

# ECDH P-256 private key (DER, base64) used to decrypt escrow-wrapped file
# keys for server-side AV scanning.  When absent, the AV webhook fields are
# hidden in the admin panel and no scan tasks are triggered.
# Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout \
#     | openssl pkcs8 -topk8 -nocrypt -outform DER | base64
# TUSSHARE_ESCROW_PRIVATE_KEY=

# Seed value for "require clean scan before download" (overridable via admin UI).
# TUSSHARE_AV_REQUIRE_CLEAN=false
# TUSSHARE_AV_SCAN_RETRY_ATTEMPTS=3


# =============================================================================
# LOGGING
# =============================================================================

# Emit structured JSON on stdout instead of human-readable text.
# Enable for log shippers like Filebeat, Vector, or Fluentd.
# TUSSHARE_LOG_JSON=false


# =============================================================================
# OPTIONAL TUNING — defaults are sensible; adjust as needed
# =============================================================================

# Debug mode — enables /api/docs Swagger UI.  Disable in production.
# TUSSHARE_DEBUG=false

# Data directories (inside container — change only if not using Docker volumes)
# TUSSHARE_DATA_DIR=/data
# TUSSHARE_FILES_DIR=/data/files
# TUSSHARE_UPLOADS_DIR=/data/uploads

# JWT token lifetimes
# TUSSHARE_ACCESS_TOKEN_EXPIRE_MINUTES=5
# TUSSHARE_REFRESH_TOKEN_EXPIRE_DAYS=7
# TUSSHARE_SESSION_IDLE_TIMEOUT_MINUTES=10

# Share session tokens (IP-bound JWT for public share access)
# TUSSHARE_SHARE_SESSION_EXPIRE_HOURS=2

# Upload settings
# TUSSHARE_DEFAULT_CHUNK_SIZE=5242880
# TUSSHARE_TUS_UPLOAD_EXPIRY_HOURS=24
# Page-cache eviction stride for upload staging blobs (MiB).
# Peak cache ≈ stride × concurrent uploads.
# 0=disabled (fine for NVMe/high-RAM). Lower (8–32) for RAM-constrained hosts,
# higher (64–256) for NFS/SMB where fdatasync is a round-trip.
# TUSSHARE_UPLOAD_EVICT_STRIDE_MB=32

# Admin panel defaults — seed the database on first run; overridable via admin UI.
# TUSSHARE_OPEN_REGISTRATION=false
# TUSSHARE_GLOBAL_MAX_FILE_SIZE=0       # bytes; 0 = no limit
# TUSSHARE_GLOBAL_BANDWIDTH_LIMIT=0     # bytes/s; 0 = no limit
# TUSSHARE_DISK_WARNING_THRESHOLD=65    # filesystem usage % that triggers admin alert

# Rate limiting
# TUSSHARE_RATE_LIMIT_LOGIN=5           # requests per 15 min per IP (login/register)
# TUSSHARE_RATE_LIMIT_API=60            # requests per min per user
# TUSSHARE_RATE_LIMIT_SHARE_CREATE=5    # share creations per min per user
# TUSSHARE_RATE_LIMIT_UPLOAD=10         # upload initiations per min per user
# TUSSHARE_RATE_LIMIT_MANAGEMENT=120    # folder/share CRUD actions per min per user

# Error-rate escalation (brute-force / scanning detection)
# IPs that accumulate >= ERROR_THRESHOLD non-429 4xx/5xx responses within
# ERROR_WINDOW seconds are throttled to ESCALATED_MAX req/ESCALATED_WINDOW sec
# for ESCALATED_DURATION seconds. Set ERROR_THRESHOLD=0 to disable entirely.
# TUSSHARE_RATE_LIMIT_ERROR_THRESHOLD=5
# TUSSHARE_RATE_LIMIT_ERROR_WINDOW=60
# TUSSHARE_RATE_LIMIT_ESCALATED_MAX=1
# TUSSHARE_RATE_LIMIT_ESCALATED_WINDOW=1
# TUSSHARE_RATE_LIMIT_ESCALATED_DURATION=300
